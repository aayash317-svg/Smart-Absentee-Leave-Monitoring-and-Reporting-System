# MongoDB Database Configurations
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=smart_absentee_db_v2

# Security & JWT Tokens
JWT_SECRET=your-super-secret-key-for-jwt-2026-enterprise-app
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Notification Server (SMTP) (Optional fallback mock logs if missing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Twilio SMS Server (Optional fallback mock logs if missing)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
